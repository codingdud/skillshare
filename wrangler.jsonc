{
  "name": "skillshare",
  "compatibility_date": "2026-10-01",
  "main": "./apps/web/worker.js",
  "vars": {
    "VITE_API_URL": "https://skillshare-lovat.vercel.app"
  },
  "previews": {
    "vars": {
      "VITE_API_URL": "https://skillshare-lovat.vercel.app"
    }
  },
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
