{
  "name": "@skillshare/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc --noEmit && tsup",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "admin:create": "tsx --env-file-if-exists=.env src/db/create-admin.ts",
    "admin:grant": "tsx --env-file-if-exists=.env src/db/grant-admin.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "*",
    "@skillshare/contracts": "*",
    "argon2": "*",
    "cookie-parser": "*",
    "cors": "*",
    "express": "*",
    "express-rate-limit": "*",
    "fflate": "^0.8.3",
    "helmet": "*",
    "jose": "*",
    "nodemailer": "^10.0.12",
    "pg": "*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "*",
    "@types/cors": "*",
    "@types/express": "*",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "*",
    "tsup": "*",
    "tsx": "*"
  }
}
